+    // --- custom splash override ------------------------------------------
+    // Drop a PNG/JPG at $KRITA_CUSTOM_SPLASH, or at
+    // <config dir>/custom_splash.png (e.g. ~/.config/krita/custom_splash.png
+    // on Linux), to replace the splash image without recompiling Krita.
+    QString customPath = qEnvironmentVariable("KRITA_CUSTOM_SPLASH");
+    if (customPath.isEmpty()) {
+        customPath = QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation)
+                + QStringLiteral("/custom_splash.png");
+    }
+    if (QFileInfo::exists(customPath)) {
+        return Source{customPath, QString()};
+    }
